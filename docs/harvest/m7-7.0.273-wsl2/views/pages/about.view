#import "skin://theme.view"

widget(container_y, {

  widget(container_x, {
    height: 3em;
    BackButton();
  });


  widget(container_x, {
    align: center;
    spacing: 1em;

    widget(icon, {
      size: 3em;
      source: "skin://icons/movian.svg";
    });
    widget(label, {
      caption: $core.app.nameM;
      size: 3em;
    });
  });

  widget(label, {
    caption: $core.app.version + " (Windows WSL2 64-bit)";
    alpha: 0.5;
    align: center;
  });

  widget(dummy, {
    height: 2em;
  });

  widget(label, {
    caption: $core.app.copyright;
    alpha: 0.5;
    align: center;
  });

  widget(dummy, {
    height: 0.5em;
  });
  
  widget(label, {
    caption: $core.app.copyright2;
    alpha: 0.6;
    align: center;
  });

  widget(dummy, {
    height: 0.5em;
  });  

  widget(label, {
    caption: "https://movian.eu";
    alpha: 0.7;
    align: center;
  });

  widget(dummy, {
    height: 0.5em;
  });  

  widget(label, {
    caption: "https://paypal.me/webpluginsBG";
    alpha: 0.6;
    align: center;
  });
});
